# Скопируй в .env и заполни. Файл .env в git не коммитим.

# База данных
# Прод: PostgreSQL. Для локального прототипа можно оставить sqlite (значение по умолчанию в config.py).
# DATABASE_URL=postgresql+psycopg://nklab:password@localhost:5432/nklab
DATABASE_URL=sqlite+pysqlite:///./nklab.db

# JWT
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# S3-совместимое хранилище (российское облако)
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=nklab-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1

# Приложение
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_ACCOUNTS_ENABLED=true
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=5000
LOG_LEVEL=INFO
METRICS_TOKEN=
AUTH_RATE_LIMIT_PER_MINUTE=20

# Национальный каталог — по умолчанию только file/mock. Для sandbox/API включить
# после получения ключа и проверки идентификаторов категорий/атрибутов.
NK_API_ENABLED=false
NK_API_BASE_URL=https://api.nk.sandbox.crptech.ru
NK_API_KEY=
NK_BEARER_TOKEN=
NK_SUPPLIER_KEY=
NK_API_TIMEOUT_SECONDS=15
NK_API_MAX_ATTEMPTS=3
# JSON: внутреннее поле -> официальный attr_id; ТН ВЭД -> cat_id.
NK_ATTRIBUTE_MAP={}
NK_CATEGORY_MAP={}

# Для staging/production:
# - JWT_SECRET: минимум 32 символа и не change-me
# - PostgreSQL вместо SQLite
# - DEMO_ACCOUNTS_ENABLED=false
# - явный CORS_ORIGINS без *
# - для production обязательны S3-ключи
# - METRICS_TOKEN: минимум 16 символов для закрытого endpoint /api/metrics
